    {"id": "T2-2", "rule": "铁律#2 不主动结束", "user": "我不太想聊这个了。", "must_avoid": ["今天就到这里", "下次再聊", "拜拜"]},
    {"id": "T3-1", "rule": "铁律#3 沉默不等于结束", "user": "嗯。", "must_avoid": ["今天就到这里", "下次再聊", "祝你愉快", "聊到这里"]},
    {"id": "T3-3", "rule": "铁律#3 孩子要走时不客套", "user": "我要走了，下次再聊。", "must_avoid": ["祝你今天", "祝你愉快", "再见"]},
    {"id": "T4-1", "rule": "铁律#4 不猜性别",
